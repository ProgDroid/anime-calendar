host = "127.0.0.1"
port = 8080
log_level = "debug"
google_client_id = ""
google_client_secret = ""
jwt_secret = ""
compress = true
cookie_secure = false
# Key the rate limiter on the rightmost X-Forwarded-For entry instead of the
# TCP peer. Set to true ONLY behind a trusted reverse proxy (nginx); when
# clients connect directly a forged header must never pick the bucket.
trust_proxy_header = false
# Set to true only in development — exposes full API surface at /swagger-ui/
# Requires the `swagger-ui` cargo feature (on by default); a binary built with
# --no-default-features logs a warning and serves nothing here.
enable_docs = false

# Cookie domain for cross-subdomain auth (e.g. ".yourdomain.com"), so the app
# and api subdomains share one session. Leave unset in local dev — host-only
# cookies are correct there.
# cookie_domain = ".yourdomain.com"

# Shared secret Cloudflare injects as X-CF-Origin-Secret. When set, requests
# without a matching header are rejected with 403, so the origin cannot be
# reached directly, bypassing the edge. Leave unset in local dev: unset or
# empty disables the check.
# cf_origin_secret = ""

[redis]
host = "127.0.0.1"
port = 6379
password = ""
db = 0
# Full connection URL, overriding host/port/password above. Required for
# managed providers, which mandate TLS (`rediss://`). Used by the cache, the
# Pub/Sub client and the presence service alike.
# url = "rediss://default:<token>@<host>:6379"

app_base_url = "http://localhost:5173"

[app]
# "development" | "staging" | "production". The dev set_subscription CLI
# refuses to run when this is "production".
environment = "development"
# Public base URL the frontend is served from. Used to build the Stripe
# Checkout success/cancel return URLs and the Customer Portal return URL.
frontend_url = "http://localhost:5173"

[stripe]
# Test-mode credentials from your Stripe Dashboard. Live-mode keys MUST
# only ever live in your production secrets store, never in this file.
# Rotate webhook_secret when you re-create the webhook endpoint in Stripe.
publishable_key = ""
secret_key = ""
webhook_secret = ""
# Recurring price IDs created in Stripe Dashboard for the Pro tier.
# v1 pricing: $2.99/month, $24.99/year (≈30% annual savings, 14-day trial).
# Create these in test mode first via the Stripe Dashboard, then paste the
# `price_*` IDs here. See docs/checklists/2026-05-monetisation-stripe-price-update.md.
price_id_monthly = ""
price_id_annual = ""

[smtp]
host = ""
port = 587
username = ""
password = ""
from_address = "noreply@example.com"

[server.metrics]
# Expose Prometheus metrics on an HTTP listener. Bind to loopback so the
# endpoint is only reachable from other processes on the same host (or
# from Docker via host.docker.internal).
enabled = true
host = "127.0.0.1"
port = 9090

[cache]
metadata_ttl_seconds       = 86400
airing_ttl_seconds         = 900
search_ttl_seconds         = 3600
calendar_items_ttl_seconds = 300
export_ttl_seconds         = 300

[limits]
free_calendar_limit = 3
free_show_cap       = 25
pro_max_reminders   = 5

[sharing]
# Co-editor sharing limits and timing. Read by the invitation service to
# gate cap/expiry/rate-limit decisions.
editor_cap                  = 5      # max active+pending editors per calendar
invitation_expiry_days      = 7
invite_rate_limit_per_hour  = 20
presence_ttl_seconds        = 60
presence_heartbeat_seconds  = 30
sse_heartbeat_seconds       = 25
sse_max_connections_per_user = 8
