host = "127.0.0.1"
port = 9647
database = "db"
user = "user"
pass = "pass"

# Full connection string, overriding every field above. Managed Postgres
# providers hand one out complete with required query parameters (such as
# ?sslmode=require) that rebuilding from the fields would drop.
# url = "postgres://user:pass@host/db?sslmode=require"

# Upper bound on connections in the pool. There is exactly ONE pool per
# process — every mapper and service takes an Arc-backed clone — so this number
# is the whole connection budget for one instance.
#
# The arithmetic a managed Postgres has to satisfy:
#
#     max_connections × (platform max-instances) + headroom  ≤  server limit
#
# where headroom covers migrations, the set_subscription CLI and any
# interactive psql session. A Cloud SQL db-f1-micro allows roughly 25, so the
# default of 5 fits four instances with five connections to spare.
#
# Raising this is a real decision, not a tuning knob. Check it against the
# instance you actually provisioned — do not raise it just because a pool
# timed out.
# max_connections = 5

# Every field here can also be supplied by environment variable with a
# DATABASE__ prefix (DATABASE__URL, DATABASE__HOST, DATABASE__MAX_CONNECTIONS,
# ...), which is how container platforms that mount no config file are
# expected to configure it.
