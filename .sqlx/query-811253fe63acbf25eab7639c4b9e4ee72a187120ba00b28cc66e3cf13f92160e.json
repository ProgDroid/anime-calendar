  "query": "SELECT ce.user_id, ce.joined_at, ce.suspended_at, u.username, u.email\n         FROM calendar_editors ce\n         JOIN users u ON u.id = ce.user_id\n         WHERE ce.calendar_id = $1 AND ce.active = true\n         ORDER BY ce.joined_at",
